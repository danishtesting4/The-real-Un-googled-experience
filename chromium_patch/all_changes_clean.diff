+// Returns true if |url| points at a Google or YouTube property that must not be
+// offered as a New Tab Page shortcut (GoogleZero blacklist).
+bool IsBlockedNtpShortcutUrl(const GURL& url) {
+  if (!url.is_valid())
+    return false;
+  std::string host = base::ToLowerASCII(url.host());
+  // GURL normalizes the host to lowercase, but be defensive.
+  // (No transformation needed; comparison is case-insensitive by construction.)
+
+  auto domain_matches = [&host](const std::string& domain) {
+    if (host == domain)
+      return true;
+    if (host.size() > domain.size() + 1 &&
+        host.compare(host.size() - domain.size(), domain.size(), domain) == 0 &&
+        host[host.size() - domain.size() - 1] == '.') {
+      return true;
+    }
+    return false;
+  };
+
+  // google.com and all of its subdomains.
+  if (domain_matches("google.com"))
+    return true;
+  // Domains ending in the .google TLD.
+  const std::string google_tld = ".google";
+  if (host.size() > google_tld.size() &&
+      host.compare(host.size() - google_tld.size(), google_tld.size(),
+                   google_tld) == 0) {
+    return true;
+  }
+  // youtube.com and all of its subdomains.
+  if (domain_matches("youtube.com"))
+    return true;
+  // youtu.be (exact host).
+  if (host == "youtu.be")
+    return true;
+  // youtube-nocookie.com and all of its subdomains.
+  if (domain_matches("youtube-nocookie.com"))
+    return true;
+
+  return false;
+}
